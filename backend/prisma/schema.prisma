generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CAPITAL_SEEKER
  INVESTOR
  ADMIN
}

enum EntityType {
  STARTUP
  SME
  BOTH
}

enum InvestorCategory {
  MICRO_INVESTOR
  ANGEL
  SYNDICATE_LEAD
  MICRO_VC
  VC_FUND
  FAMILY_OFFICE
  CORPORATE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DocumentType {
  PITCH_DECK
  FINANCIAL_MODEL
  BUSINESS_PLAN
  TERM_SHEET
  CAP_TABLE

  GOVERNMENT_CONTRACT

  PURCHASE_ORDER
  REVENUE_PROOF
  CUSTOMER_CONTRACT

  PATENT_CERTIFICATE
  ACCELERATOR_CERTIFICATE
  STARTUP_INDIA_CERTIFICATE
  NDA
  OTHER
  DILIGENCE_REQUEST
}

enum DocumentVisibility {
  PUBLIC
  INTERESTED_ONLY
}

enum VerificationStatus {
  UPLOADED
  THIRD_PARTY_VERIFIED
  KUBERLIST_REVIEWED
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
}

model User {
  id                                   String                         @id @default(uuid())
  name                                 String
  email                                String                         @unique
  password_hash                        String
  role                                 Role
  is_system                            Boolean                        @default(false)
  created_at                           DateTime                       @default(now())
  updated_at                           DateTime                       @updatedAt
  is_active                            Boolean                        @default(true)
  capitalSeekerProfile                 CapitalSeekerProfile?
  investorProfile                      InvestorProfile?
  listings                             StartupListing[]
  sentInterests                        Interest[]                     @relation("InvestorInterests")
  savedStartups                        SavedStartup[]
  refreshTokens                        RefreshToken[]
  investorConnections                  Connection[]                   @relation("InvestorConnections")
  seekerConnections                    Connection[]                   @relation("SeekerConnections")
  investments                          Investment[]                   @relation("InvestorInvestments")
  external_organizations               ExternalOrganization[]         @relation("InvestorExternalOrganizations")
  sentMessages                         Message[]
  documentAccessLogs                   DocumentAccessLog[]
  activities                           Activity[]
  notifications                        Notification[]
  diligence_requests                   DiligenceRequest[]
  profile_image_url                    String?
  shared_documents                     SharedDocument[]
  secondary_opportunities              SecondaryOpportunity[]         @relation("SecondaryOpportunitySeller")
  secondary_interests                  SecondaryInterest[]            @relation("SecondaryOpportunityInvestor")
  secondary_deals_as_seller            SecondaryDeal[]                @relation("SecondaryDealSeller")
  secondary_deals_as_buyer             SecondaryDeal[]                @relation("SecondaryDealBuyer")
  secondary_messages                   SecondaryMessage[]
  secondary_deal_documents             SecondaryDealDocument[]        @relation("SecondaryDealDocumentUploader")
  secondary_document_requests_made     SecondaryDealDocumentRequest[] @relation("SecondaryDealDocumentRequester")
  secondary_document_requests_received SecondaryDealDocumentRequest[] @relation("SecondaryDealDocumentRequestedFrom")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([user_id])
}

model CapitalSeekerProfile {
  id                 String     @id @default(uuid())
  user_id            String     @unique
  user               User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  entity_type        EntityType @default(STARTUP)
  organisation_name  String?
  linkedin_url       String?
  experience_summary String?
  city               String?
  country            String?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
}

model InvestorProfile {
  id                    String           @id @default(uuid())
  user_id               String           @unique
  user                  User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  investor_category     InvestorCategory @default(ANGEL)
  fund_name             String?
  aum_range             String?
  ticket_min            Float?
  ticket_max            Float?
  preferred_sectors     String[]
  preferred_stage       String[]
  preferred_entity_type EntityType       @default(BOTH)
  geography_preference  String?
  lead_interest         Boolean          @default(false)
  co_invest_interest    Boolean          @default(false)
  board_seat_interest   Boolean          @default(false)
  bio                   String?
  linkedin_url          String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
}

model StartupListing {
  id                        String                 @id @default(uuid())
  capital_seeker_id         String
  capital_seeker            User                   @relation(fields: [capital_seeker_id], references: [id], onDelete: Cascade)
  name                      String
  sector                    String
  stage                     String
  entity_type               EntityType             @default(STARTUP)
  location_city             String?
  location_country          String                 @default("India")
  funding_ask               Float?
  valuation_expectation     Float?
  revenue_last_year         Float?
  monthly_burn              Float?
  summary                   String
  use_of_funds              String?
  is_active                 Boolean                @default(true)
  status                    ListingStatus          @default(DRAFT)
  rejection_reason          String?
  view_count                Int                    @default(0)
  // Traction & Credibility fields
  has_purchase_orders       Boolean                @default(false)
  po_value                  Float?
  po_count                  Int?
  has_government_contract   Boolean                @default(false)
  has_ip                    Boolean                @default(false)
  ip_description            String?
  awards_recognition        String?
  government_contract_proof String?
  patent_number             String?
  accelerator_name          String?
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt
  requires_nda              Boolean                @default(false)
  interests                 Interest[]
  savedBy                   SavedStartup[]
  documents                 Document[]
  updates                   StartupUpdate[]
  score                     ListingScore?
  connections               Connection[]
  diligence_requests        DiligenceRequest[]
  investments               Investment[]
  secondary_opportunities   SecondaryOpportunity[] @relation("SecondaryOpportunityListing")
  valuations                CompanyValuation[]
}

model Document {
  id               String          @id @default(uuid())
  startup_id       String
  startup          StartupListing  @relation(fields: [startup_id], references: [id], onDelete: Cascade)
  file_name        String
  storage_provider StorageProvider @default(LOCAL)
  file_url         String
  public_id        String?

  mime_type String

  original_file_name String?

  storage_path        String?
  file_size           Int?
  document_type       DocumentType       @default(OTHER)
  visibility          DocumentVisibility @default(INTERESTED_ONLY)
  verification_status VerificationStatus @default(UPLOADED)
  verified_by         String?
  verified_at         DateTime?
  verification_notes  String?
  uploaded_at         DateTime           @default(now())
  diligence_responses DiligenceRequest[]
  shared_connections  SharedDocument[]
  dd_requirements     DDRequirement[]

  @@index([startup_id])
  @@index([visibility])
  @@index([startup_id, visibility])
  @@index([uploaded_at])
  @@index([document_type])
}

model DiligenceRequest {
  id String @id @default(cuid())

  startup_id  String
  investor_id String

  title        String
  request_type String

  notes String?

  status DiligenceRequestStatus @default(REQUESTED)

  requested_at DateTime @default(now())

  completed_at DateTime?

  response_document_id String?

  startup StartupListing @relation(fields: [startup_id], references: [id])

  investor User @relation(fields: [investor_id], references: [id])

  response_document Document? @relation(fields: [response_document_id], references: [id])

  dd_requirement DDRequirement?
}

enum DiligenceRequestStatus {
  REQUESTED
  UPLOADED
  UNDER_REVIEW
  COMPLETED
}

model DDChecklistTemplate {
  id          String     @id @default(uuid())
  name        String
  description String?
  entity_type EntityType @default(STARTUP)
  is_active   Boolean    @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items          DDChecklistItem[]
  due_diligences DueDiligence[]
}

model DDChecklistItem {
  id String @id @default(uuid())

  template_id String
  template    DDChecklistTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  category    DDCategory
  title       String
  description String?
  required    Boolean    @default(true)
  sort_order  Int        @default(0)

  requirements DDRequirement[]

  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  weight        Int             @default(1)
  applicability DDApplicability @default(CORE)

  @@index([template_id])
  @@index([category])
}

model DueDiligence {
  id String @id @default(uuid())

  connection_id String     @unique
  connection    Connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  template_id String?
  template    DDChecklistTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  status DueDiligenceStatus @default(NOT_STARTED)

  readiness_score Int @default(0)

  verification_score Int @default(0)

  started_at   DateTime?
  completed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  requirements DDRequirement[]

  @@index([status])
}

model DDRequirement {
  id               String       @id @default(uuid())
  due_diligence_id String
  due_diligence    DueDiligence @relation(fields: [due_diligence_id], references: [id], onDelete: Cascade)

  checklist_item_id String
  checklist_item    DDChecklistItem @relation(fields: [checklist_item_id], references: [id], onDelete: Restrict)

  status DDRequirementStatus @default(MISSING)

  verification_level DDVerificationLevel @default(NONE)

  document_id String?
  document    Document? @relation(fields: [document_id], references: [id], onDelete: SetNull)

  diligence_request_id String?           @unique
  diligence_request    DiligenceRequest? @relation(fields: [diligence_request_id], references: [id], onDelete: SetNull)

  verification_notes String?
  verified_by        String?
  verified_at        DateTime?

  notes String?

  completed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([due_diligence_id])
  @@index([checklist_item_id])
  @@index([status])
  @@index([verification_level])
  @@index([document_id])
}

enum DueDiligenceStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  COMPLETED
}

enum DDRequirementStatus {
  MISSING
  REQUESTED
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  NOT_APPLICABLE
}

enum DDVerificationLevel {
  NONE
  UPLOADED
  KUBERLIST_VERIFIED
  THIRD_PARTY_VERIFIED
}

enum DDCategory {
  CORPORATE
  FINANCIAL
  OWNERSHIP
  LEGAL
  TAX
  COMMERCIAL
  BUSINESS
  OTHER
}

enum DDApplicability {
  CORE
  IF_APPLICABLE
}

model Interest {
  id          String         @id @default(uuid())
  investor_id String
  investor    User           @relation("InvestorInterests", fields: [investor_id], references: [id], onDelete: Cascade)
  startup_id  String
  startup     StartupListing @relation(fields: [startup_id], references: [id], onDelete: Cascade)
  message     String?
  status      InterestStatus @default(PENDING)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  connection Connection?

  @@unique([investor_id, startup_id])
}

model SavedStartup {
  id          String         @id @default(uuid())
  investor_id String
  investor    User           @relation(fields: [investor_id], references: [id], onDelete: Cascade)
  startup_id  String
  startup     StartupListing @relation(fields: [startup_id], references: [id], onDelete: Cascade)
  created_at  DateTime       @default(now())

  @@unique([investor_id, startup_id])
}

model StartupUpdate {
  id         String         @id @default(uuid())
  startup_id String
  startup    StartupListing @relation(fields: [startup_id], references: [id], onDelete: Cascade)
  title      String
  content    String
  created_at DateTime       @default(now())
}

model ListingScore {
  id                 String         @id @default(uuid())
  listing_id         String         @unique
  listing            StartupListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  traction_score     Int            @default(0)
  financial_score    Int            @default(0)
  quality            Int            @default(0)
  hard_score         Int            @default(0)
  founder_score      Int            @default(0)
  market_score       Int            @default(0)
  business_score     Int            @default(0)
  credibility_score  Int            @default(0)
  readiness_score    Int            @default(0)
  narrative_score    Int            @default(0)
  penalty_points     Int            @default(0)
  total_score        Int            @default(0)
  grade              String         @default("E")
  confidence_score   Int            @default(0)
  confidence_label   String         @default("Low")
  momentum_score     Int            @default(0)
  previous_total     Int            @default(0)
  previous_traction  Int            @default(0)
  previous_financial Int            @default(0)
  verdict            String         @default("")
  top_drivers        String[]
  top_risks          String[]
  last_updated       DateTime       @default(now())
}

enum DealStage {
  ACCEPTED
  INTRO_CALL
  MEETING
  DUE_DILIGENCE
  TERM_SHEET
  CLOSED
  DROPPED
}

enum ConnectionStatus {
  ACTIVE
  CLOSED
}

enum InvestmentStatus {
  ACTIVE
  EXITED
  WRITTEN_OFF
}

enum InvestmentInstrument {
  EQUITY
  SAFE
  CONVERTIBLE_NOTE
  DEBT
  REVENUE_BASED_FINANCING
  OTHER
}

enum SecondaryOpportunityStatus {
  DRAFT
  PENDING_REVIEW
  LIVE
  IN_DISCUSSION
  COMPLETED
  WITHDRAWN
  EXPIRED
  REJECTED
}

enum SecondarySaleType {
  FULL
  PARTIAL
}

enum PriceVisibility {
  PUBLIC
  ON_REQUEST
}

enum SecondaryInterestStatus {
  EXPRESSED
  APPROVED
  DECLINED
  WITHDRAWN
}

enum SecondaryDealStatus {
  IN_DISCUSSION
  NEGOTIATING
  AGREED
  COMPLETED
  FAILED
  WITHDRAWN
}

model Connection {
  id           String           @id @default(uuid())
  listing_id   String
  listing      StartupListing   @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  investor_id  String
  investor     User             @relation("InvestorConnections", fields: [investor_id], references: [id], onDelete: Cascade)
  seeker_id    String
  seeker       User             @relation("SeekerConnections", fields: [seeker_id], references: [id], onDelete: Cascade)
  interest_id  String           @unique
  interest     Interest         @relation(fields: [interest_id], references: [id], onDelete: Cascade)
  status       ConnectionStatus @default(ACTIVE)
  deal_stage   DealStage        @default(ACCEPTED)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  nda_required Boolean          @default(false)

  nda_executed Boolean @default(false)

  nda_requirement_overridden Boolean @default(false)

  nda_document_id String?

  nda_executed_at DateTime?

  nda_overridden_at DateTime?

  nda_uploaded_by String?

  nda_overridden_by  String?
  messages           Message[]
  outcome            String? // WON | LOST
  deal_amount        Float?
  round_type         String?
  lead_investor_name String?
  closed_at          DateTime?
  outcome_notes      String?
  stage_updated_at   DateTime         @default(now())
  stage_history      Json? // [{stage, changed_at, changed_by}]
  shared_documents   SharedDocument[]
  investment         Investment?
  due_diligence      DueDiligence?

  @@unique([investor_id, listing_id])
}

model Investment {
  id String @id @default(uuid())

  investor_id String
  investor    User   @relation("InvestorInvestments", fields: [investor_id], references: [id], onDelete: Cascade)

  // KuberList organization
  listing_id String?
  listing    StartupListing? @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  // External organization
  external_organization_id String?
  external_organization    ExternalOrganization? @relation(fields: [external_organization_id], references: [id], onDelete: Cascade)

  connection_id String?     @unique
  connection    Connection? @relation(fields: [connection_id], references: [id], onDelete: SetNull)

  invested_amount Float
  invested_at     DateTime

  instrument InvestmentInstrument @default(EQUITY)

  entry_valuation      Float?
  ownership_percentage Float?

  status InvestmentStatus @default(ACTIVE)

  current_value_override Float?

  exit_value Float?
  exited_at  DateTime?

  notes String?

  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt
  secondary_opportunities SecondaryOpportunity[] @relation("InvestmentSecondaryOpportunities")

  @@index([investor_id])
  @@index([listing_id])
  @@index([external_organization_id])
  @@index([status])
}

model ExternalOrganization {
  id String @id @default(uuid())

  investor_id String
  investor    User   @relation("InvestorExternalOrganizations", fields: [investor_id], references: [id], onDelete: Cascade)

  name        String
  website     String?
  sector      String?
  country     String?
  description String?

  investments             Investment[]
  secondary_opportunities SecondaryOpportunity[] @relation("SecondaryOpportunityExternalOrganization")
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt

  @@index([investor_id])
}

model SecondaryOpportunity {
  id String @id @default(uuid())

  seller_id String
  seller    User   @relation("SecondaryOpportunitySeller", fields: [seller_id], references: [id], onDelete: Cascade)

  investment_id String?
  investment    Investment? @relation("InvestmentSecondaryOpportunities", fields: [investment_id], references: [id], onDelete: SetNull)

  listing_id String?
  listing    StartupListing? @relation("SecondaryOpportunityListing", fields: [listing_id], references: [id], onDelete: Cascade)

  external_organization_id String?
  external_organization    ExternalOrganization? @relation("SecondaryOpportunityExternalOrganization", fields: [external_organization_id], references: [id], onDelete: Cascade)

  instrument InvestmentInstrument
  sale_type  SecondarySaleType

  ownership_percentage Float?
  stake_description    String?

  asking_price             Float
  price_visibility         PriceVisibility @default(PUBLIC)
  minimum_transaction_size Float?

  expires_at DateTime?
  notes      String?

  status           SecondaryOpportunityStatus @default(DRAFT)
  rejection_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  interests SecondaryInterest[]
  deals     SecondaryDeal[]

  @@index([seller_id])
  @@index([investment_id])
  @@index([listing_id])
  @@index([external_organization_id])
  @@index([status])
  @@index([expires_at])
}

model SecondaryInterest {
  id String @id @default(uuid())

  opportunity_id String
  opportunity    SecondaryOpportunity @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)

  investor_id String
  investor    User   @relation("SecondaryOpportunityInvestor", fields: [investor_id], references: [id], onDelete: Cascade)

  message String?
  status  SecondaryInterestStatus @default(EXPRESSED)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal SecondaryDeal?

  @@unique([opportunity_id, investor_id])
  @@index([investor_id])
  @@index([status])
}

model SecondaryDeal {
  id String @id @default(uuid())

  opportunity_id String
  opportunity    SecondaryOpportunity @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)

  secondary_interest_id String            @unique
  secondary_interest    SecondaryInterest @relation(fields: [secondary_interest_id], references: [id], onDelete: Cascade)

  seller_id String
  seller    User   @relation("SecondaryDealSeller", fields: [seller_id], references: [id], onDelete: Cascade)

  buyer_id String
  buyer    User   @relation("SecondaryDealBuyer", fields: [buyer_id], references: [id], onDelete: Cascade)

  status SecondaryDealStatus @default(IN_DISCUSSION)

  agreed_price         Float?
  agreed_stake_details String?
  outcome_notes        String?
  completed_at         DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  messages          SecondaryMessage[]
  documents         SecondaryDealDocument[]
  document_requests SecondaryDealDocumentRequest[]

  @@index([opportunity_id])
  @@index([seller_id])
  @@index([buyer_id])
  @@index([status])
}

model SecondaryMessage {
  id String @id @default(uuid())

  deal_id String
  deal    SecondaryDeal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  sender_id String
  sender    User   @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  message String

  attachments String[] @default([])
  read_by     String[] @default([])

  is_system    Boolean @default(false)
  message_type String  @default("TEXT")
  metadata     Json?

  created_at DateTime @default(now())

  @@index([deal_id])
  @@index([sender_id])
}

model CompanyValuation {
  id String @id @default(uuid())

  listing_id String
  listing    StartupListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  valuation      Float
  valuation_date DateTime

  source String?
  notes  String?

  created_at DateTime @default(now())

  @@unique([listing_id, valuation_date])
  @@index([listing_id])
  @@index([valuation_date])
}

model Message {
  id            String     @id @default(uuid())
  connection_id String
  connection    Connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  sender_id     String
  sender        User       @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  message       String
  attachments   String[]
  read_by       String[]
  is_system     Boolean    @default(false)
  message_type  String     @default("TEXT") // TEXT | SYSTEM | SUGGESTED_ACTION
  metadata      Json?
  created_at    DateTime   @default(now())
}

model DocumentAccessLog {
  id          String   @id @default(uuid())
  document_id String
  investor_id String
  investor    User     @relation(fields: [investor_id], references: [id], onDelete: Cascade)
  startup_id  String
  viewed_at   DateTime @default(now())

  @@index([startup_id])
  @@index([investor_id])
  @@index([document_id])
  @@index([viewed_at])
}

model Activity {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  listing_id String?
  type       String // VIEW | SAVE | INTEREST | DISCUSSION
  sector     String? // denormalised for fast profile building
  created_at DateTime @default(now())

  @@index([user_id, listing_id, type])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       String // INTEREST_RECEIVED | LISTING_APPROVED | STAGE_CHANGED | MESSAGE_RECEIVED | SCORE_IMPROVED
  title      String
  message    String
  link       String?
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id, read])
}

model SharedDocument {
  id            String   @id @default(cuid())
  connection_id String
  document_id   String
  shared_by     String
  shared_at     DateTime @default(now())

  connection Connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  document   Document   @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [shared_by], references: [id])

  @@unique([connection_id, document_id])
  @@index([connection_id])
  @@index([document_id])
}

model SecondaryDealDocument {
  id String @id @default(uuid())

  deal_id String
  deal    SecondaryDeal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  uploaded_by String
  uploader    User   @relation("SecondaryDealDocumentUploader", fields: [uploaded_by], references: [id], onDelete: Cascade)

  file_name          String
  original_file_name String?

  storage_provider StorageProvider @default(LOCAL)
  file_url         String
  public_id        String?

  mime_type    String
  storage_path String?
  file_size    Int?

  document_type DocumentType @default(OTHER)

  uploaded_at       DateTime                       @default(now())
  document_requests SecondaryDealDocumentRequest[]

  @@index([deal_id])
  @@index([uploaded_by])
  @@index([uploaded_at])
}

model SecondaryDealDocumentRequest {
  id String @id @default(uuid())

  deal_id String
  deal    SecondaryDeal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  requested_by String
  requester    User   @relation("SecondaryDealDocumentRequester", fields: [requested_by], references: [id], onDelete: Cascade)

  requested_from      String
  requested_from_user User   @relation("SecondaryDealDocumentRequestedFrom", fields: [requested_from], references: [id], onDelete: Cascade)

  title       String
  description String?

  status SecondaryDocumentRequestStatus @default(REQUESTED)

  document_id String?
  document    SecondaryDealDocument? @relation(fields: [document_id], references: [id], onDelete: SetNull)

  created_at   DateTime  @default(now())
  completed_at DateTime?

  @@index([deal_id])
  @@index([requested_by])
  @@index([requested_from])
  @@index([status])
}

enum SecondaryDocumentRequestStatus {
  REQUESTED
  FULFILLED
  DECLINED
  CANCELLED
}
