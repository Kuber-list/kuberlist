generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CAPITAL_SEEKER
  INVESTOR
  ADMIN
}

enum EntityType {
  STARTUP
  SME
  BOTH
}

enum InvestorCategory {
  MICRO_INVESTOR
  ANGEL
  SYNDICATE_LEAD
  MICRO_VC
  VC_FUND
  FAMILY_OFFICE
  CORPORATE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DocumentType {
  PITCH_DECK
  FINANCIAL_MODEL
  BUSINESS_PLAN
  TERM_SHEET
  CAP_TABLE

  GOVERNMENT_CONTRACT

  PURCHASE_ORDER
  REVENUE_PROOF
  CUSTOMER_CONTRACT

  PATENT_CERTIFICATE
  ACCELERATOR_CERTIFICATE
  STARTUP_INDIA_CERTIFICATE
  NDA
  OTHER
  DILIGENCE_REQUEST
}

enum DocumentVisibility {
  PUBLIC
  INTERESTED_ONLY
}

enum VerificationStatus {
  UPLOADED
  THIRD_PARTY_VERIFIED
  KUBERLIST_REVIEWED
}
enum StorageProvider {
  LOCAL
  CLOUDINARY
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role
  is_system     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
is_active Boolean @default(true)
  capitalSeekerProfile CapitalSeekerProfile?
  investorProfile      InvestorProfile?
  listings             StartupListing[]
  sentInterests        Interest[]            @relation("InvestorInterests")
  savedStartups        SavedStartup[]
  refreshTokens        RefreshToken[]
  investorConnections  Connection[]          @relation("InvestorConnections")
  seekerConnections    Connection[]          @relation("SeekerConnections")
  sentMessages         Message[]
  documentAccessLogs   DocumentAccessLog[]
  activities           Activity[]
  notifications        Notification[]
  diligence_requests   DiligenceRequest[]
  profile_image_url    String?
  shared_documents     SharedDocument[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  @@index([user_id])
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())
}

model CapitalSeekerProfile {
  id                 String     @id @default(uuid())
  user_id            String     @unique
  user               User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  entity_type        EntityType @default(STARTUP)
  organisation_name  String?
  linkedin_url       String?
  experience_summary String?
  city               String?
  country            String?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
}

model InvestorProfile {
  id                    String           @id @default(uuid())
  user_id               String           @unique
  user                  User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  investor_category     InvestorCategory @default(ANGEL)
  fund_name             String?
  aum_range             String?
  ticket_min            Float?
  ticket_max            Float?
  preferred_sectors     String[]
  preferred_stage       String[]
  preferred_entity_type EntityType       @default(BOTH)
  geography_preference  String?
  lead_interest         Boolean          @default(false)
  co_invest_interest    Boolean          @default(false)
  board_seat_interest   Boolean          @default(false)
  bio                   String?
  linkedin_url          String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
}

model StartupListing {
  id                        String             @id @default(uuid())
  capital_seeker_id         String
  capital_seeker            User               @relation(fields: [capital_seeker_id], references: [id], onDelete: Cascade)
  name                      String
  sector                    String
  stage                     String
  entity_type               EntityType         @default(STARTUP)
  location_city             String?
  location_country          String             @default("India")
  funding_ask               Float?
  valuation_expectation     Float?
  revenue_last_year         Float?
  monthly_burn              Float?
  summary                   String
  use_of_funds              String?
  is_active                 Boolean            @default(true)
  status                    ListingStatus      @default(DRAFT)
  rejection_reason          String?
  view_count                Int                @default(0)
  // Traction & Credibility fields
  has_purchase_orders       Boolean            @default(false)
  po_value                  Float?
  po_count                  Int?
  has_government_contract   Boolean            @default(false)
  has_ip                    Boolean            @default(false)
  ip_description            String?
  awards_recognition        String?
  government_contract_proof String?
  patent_number             String?
  accelerator_name          String?
  created_at                DateTime           @default(now())
  updated_at                DateTime           @updatedAt
  requires_nda              Boolean            @default(false)
  interests                 Interest[]
  savedBy                   SavedStartup[]
  documents                 Document[]
  updates                   StartupUpdate[]
  score                     ListingScore?
  connections               Connection[]
  diligence_requests        DiligenceRequest[]
}

model Document {
  id                  String             @id @default(uuid())
  startup_id          String
  startup             StartupListing     @relation(fields: [startup_id], references: [id], onDelete: Cascade)
  file_name           String
 storage_provider StorageProvider @default(LOCAL)
file_url String
public_id String?

mime_type String

original_file_name String?

storage_path String?
  file_size           Int?
  document_type       DocumentType       @default(OTHER)
  visibility DocumentVisibility @default(INTERESTED_ONLY)
  verification_status VerificationStatus @default(UPLOADED)
  verified_by         String?
  verified_at         DateTime?
  verification_notes  String?
  uploaded_at         DateTime           @default(now())
  diligence_responses DiligenceRequest[]
  shared_connections  SharedDocument[]
  @@index([startup_id])

@@index([visibility])
@@index([startup_id, visibility])
@@index([uploaded_at])

@@index([document_type])
}

model DiligenceRequest {
  id String @id @default(cuid())

  startup_id  String
  investor_id String

  title        String
  request_type String

  notes String?

  status DiligenceRequestStatus @default(REQUESTED)

  requested_at DateTime @default(now())

  completed_at DateTime?

  response_document_id String?

  startup StartupListing @relation(fields: [startup_id], references: [id])

  investor User @relation(fields: [investor_id], references: [id])

  response_document Document? @relation(fields: [response_document_id], references: [id])
}

enum DiligenceRequestStatus {
  REQUESTED
  UPLOADED
  UNDER_REVIEW
  COMPLETED
}

model Interest {
  id          String         @id @default(uuid())
  investor_id String
  investor    User           @relation("InvestorInterests", fields: [investor_id], references: [id], onDelete: Cascade)
  startup_id  String
  startup     StartupListing @relation(fields: [startup_id], references: [id], onDelete: Cascade)
  message     String?
  status      InterestStatus @default(PENDING)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  connection Connection?

  @@unique([investor_id, startup_id])
}

model SavedStartup {
  id          String         @id @default(uuid())
  investor_id String
  investor    User           @relation(fields: [investor_id], references: [id], onDelete: Cascade)
  startup_id  String
  startup     StartupListing @relation(fields: [startup_id], references: [id], onDelete: Cascade)
  created_at  DateTime       @default(now())

  @@unique([investor_id, startup_id])
}

model StartupUpdate {
  id         String         @id @default(uuid())
  startup_id String
  startup    StartupListing @relation(fields: [startup_id], references: [id], onDelete: Cascade)
  title      String
  content    String
  created_at DateTime       @default(now())
}

model ListingScore {
  id                 String         @id @default(uuid())
  listing_id         String         @unique
  listing            StartupListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  traction_score     Int            @default(0)
  financial_score    Int            @default(0)
  quality            Int            @default(0)
  hard_score         Int            @default(0)
  founder_score      Int            @default(0)
  market_score       Int            @default(0)
  business_score     Int            @default(0)
  credibility_score  Int            @default(0)
  readiness_score    Int            @default(0)
  narrative_score    Int            @default(0)
  penalty_points     Int            @default(0)
  total_score        Int            @default(0)
  grade              String         @default("E")
  confidence_score   Int            @default(0)
  confidence_label   String         @default("Low")
  momentum_score     Int            @default(0)
  previous_total     Int            @default(0)
  previous_traction  Int            @default(0)
  previous_financial Int            @default(0)
  verdict            String         @default("")
  top_drivers        String[]
  top_risks          String[]
  last_updated       DateTime       @default(now())
}

enum DealStage {
  ACCEPTED
  INTRO_CALL
  MEETING
  DUE_DILIGENCE
  TERM_SHEET
  CLOSED
  DROPPED
}

enum ConnectionStatus {
  ACTIVE
  CLOSED
}

model Connection {
  id           String           @id @default(uuid())
  listing_id   String
  listing      StartupListing   @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  investor_id  String
  investor     User             @relation("InvestorConnections", fields: [investor_id], references: [id], onDelete: Cascade)
  seeker_id    String
  seeker       User             @relation("SeekerConnections", fields: [seeker_id], references: [id], onDelete: Cascade)
  interest_id  String           @unique
  interest     Interest         @relation(fields: [interest_id], references: [id], onDelete: Cascade)
  status       ConnectionStatus @default(ACTIVE)
  deal_stage   DealStage        @default(ACCEPTED)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  nda_required Boolean          @default(false)

  nda_executed Boolean @default(false)

  nda_requirement_overridden Boolean @default(false)

  nda_document_id String?

  nda_executed_at DateTime?

  nda_overridden_at DateTime?

  nda_uploaded_by String?

  nda_overridden_by  String?
  messages           Message[]
  outcome            String? // WON | LOST
  deal_amount        Float?
  round_type         String?
  lead_investor_name String?
  closed_at          DateTime?
  outcome_notes      String?
  stage_updated_at   DateTime         @default(now())
  stage_history      Json? // [{stage, changed_at, changed_by}]
  shared_documents   SharedDocument[]

  @@unique([investor_id, listing_id])
}

model Message {
  id            String     @id @default(uuid())
  connection_id String
  connection    Connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  sender_id     String
  sender        User       @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  message       String
  attachments   String[]
  read_by       String[]
  is_system     Boolean    @default(false)
  message_type  String     @default("TEXT") // TEXT | SYSTEM | SUGGESTED_ACTION
  metadata      Json?
  created_at    DateTime   @default(now())
}

model DocumentAccessLog {
  id          String   @id @default(uuid())
  document_id String
  investor_id String
  investor    User     @relation(fields: [investor_id], references: [id], onDelete: Cascade)
  startup_id  String
  viewed_at   DateTime @default(now())
  @@index([startup_id])

@@index([investor_id])

@@index([document_id])

@@index([viewed_at])
}

model Activity {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  listing_id String?
  type       String // VIEW | SAVE | INTEREST | DISCUSSION
  sector     String? // denormalised for fast profile building
  created_at DateTime @default(now())

  @@index([user_id, listing_id, type])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       String // INTEREST_RECEIVED | LISTING_APPROVED | STAGE_CHANGED | MESSAGE_RECEIVED | SCORE_IMPROVED
  title      String
  message    String
  link       String?
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id, read])
}

model SharedDocument {
  id            String   @id @default(cuid())
  connection_id String
  document_id   String
  shared_by     String
  shared_at     DateTime @default(now())

  connection Connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  document   Document   @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [shared_by], references: [id])

  @@unique([connection_id, document_id])
  @@index([connection_id])
  @@index([document_id])
}
